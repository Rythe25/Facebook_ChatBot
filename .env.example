# Copy this file to .env, then fill in your values:
#   PowerShell:  Copy-Item .env.example .env
#
# NEVER commit your real .env — it holds secrets.
#
# IMPORTANT: every name below must match a field in app/config.py exactly.
# An unknown key makes the app fail at startup with "Extra inputs are not
# permitted" (e.g. GEMINI_API_KEY instead of GOOGLE_API_KEY).
#
# Comments live on their own lines here on purpose — a trailing "# ..." after a
# value is easy to paste over and hard to spot when it goes wrong.


# ============================================================
# Facebook Messenger
# ============================================================

# Any random string you invent. Must match exactly what you type into the
# Meta dashboard's webhook "Verify token" field.
FB_VERIFY_TOKEN=

# Page Access Token, from Meta dashboard -> Messenger -> Messenger API Settings.
FB_PAGE_ACCESS_TOKEN=


# ============================================================
# LLM provider
# ============================================================

# "gemini" (default) or "openai".
LLM_PROVIDER=gemini

# Gemini API key from https://aistudio.google.com/apikey
# Also used for the RAG embeddings, so it is required even with OpenAI chat.
GOOGLE_API_KEY=

# Only needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=


# ============================================================
# Pinecone (FAQ retrieval)
# ============================================================

# From https://app.pinecone.io — starts with "pcsk_".
PINECONE_API_KEY=

PINECONE_INDEX_NAME=fanpage-faqs

# Create the index and load data/faqs.csv into it before starting the server:
#   python scripts/create_index.py
#   python scripts/upload_faqs.py


# ============================================================
# Google Sheets (order / reservation logging)
# ============================================================

GOOGLE_SHEETS_CREDENTIALS_PATH=app/credentials/service_account.json

# The long id in the sheet URL: /spreadsheets/d/<THIS>/edit
GOOGLE_SHEETS_ID=

# Share the sheet with the service account's client_email as Editor, or
# save_booking fails with 403 "caller does not have permission".


# ============================================================
# Misc
# ============================================================

LOG_LEVEL=INFO
