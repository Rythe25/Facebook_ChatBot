# Copy this file to .env, then fill in your values:
#   PowerShell:  Copy-Item .env.example .env
# NEVER commit your real .env — it holds secrets.
#
# IMPORTANT: every name below must match a field in app/config.py exactly.
# An unknown key in .env makes the app fail at startup with
# "Extra inputs are not permitted" (e.g. GEMINI_API_KEY instead of GOOGLE_API_KEY).

# === Facebook (Session 1) ===
FB_VERIFY_TOKEN=            # any random string you make up; must match the Meta webhook config
FB_PAGE_ACCESS_TOKEN=       # the Page Access Token from the Meta dashboard

# === LLM (Session 2) ===
LLM_PROVIDER=gemini         # "gemini" (default) or "openai"
GOOGLE_API_KEY=             # Gemini API key from https://aistudio.google.com/apikey
# OPENAI_API_KEY=           # only if LLM_PROVIDER=openai

# === Pinecone / FAQ RAG (Session 3) ===
PINECONE_API_KEY=           # from https://app.pinecone.io
PINECONE_INDEX_NAME=fanpage-faqs
# Create the index and load data/faqs.csv into it before starting the server:
#   python scripts/create_index.py
#   python scripts/upload_faqs.py

# === Google Sheets booking (Session 4) ===
GOOGLE_SHEETS_CREDENTIALS_PATH=app/credentials/service_account.json
GOOGLE_SHEETS_ID=           # the long id in the sheet URL: /spreadsheets/d/<THIS>/edit
# Share the sheet with the service account's client_email as Editor,
# or save_booking fails with 403 "caller does not have permission".

# === Misc ===
LOG_LEVEL=INFO
