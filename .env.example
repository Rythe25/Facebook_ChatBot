# Copy this file to .env, then fill in your values:
#   PowerShell:  Copy-Item .env.example .env
# NEVER commit your real .env — it holds secrets.

# === Facebook (Session 1) ===
FB_VERIFY_TOKEN=            # any random string you make up; must match the Meta webhook config
FB_PAGE_ACCESS_TOKEN=       # the Page Access Token from the Meta dashboard

# === Misc ===
LOG_LEVEL=INFO
